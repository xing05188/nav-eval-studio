% ------------------------------------------------------------
% 插图占位与自动替换
% ------------------------------------------------------------
% 用法：\figph[框高]{标签键}{文件名}{图题}{占位框内提示}
%   * figures/<文件名> 不存在时画虚线框占位，保留版面位置；
%   * 把 PNG/PDF 按同名放入 figures/ 后重新编译，自动切换为真实图片，
%     不需要修改正文任何一行 LaTeX。
% 可选扩展名：优先 .png，也可以是 .pdf/.jpg（写全名即可）。
\newlength{\figphheight}
\newcommand{\missingfigbox}[3]{% #1 文件名 #2 提示 #3 框高
  \begin{tikzpicture}
    \node[draw=black!45,dashed,line width=0.8pt,inner sep=8pt,
          text width=0.84\textwidth,minimum height=#3,align=center,
          fill=black!1.5,font=\small]{
      {\bfseries\color{black!60}【待补插图】}\par\vspace{0.5em}
      {\ttfamily\footnotesize \detokenize{figures/#1}}\par\vspace{0.6em}
      {\normalfont #2}\par\vspace{0.6em}
      {\footnotesize\color{black!45}%
       图片按上述文件名放入 \texttt{figures/} 后重新编译即自动替换本框}%
    };
  \end{tikzpicture}%
}
\newcommand{\figph}[5][5.6cm]{%
  \begin{figure}[H]\centering
    \IfFileExists{figures/#3}{%
      \includegraphics[width=0.92\textwidth,height=0.70\textheight,
                       keepaspectratio]{figures/#3}%
    }{%
      \missingfigbox{#3}{#5}{#1}%
    }%
    \caption{#4}\label{fig:#2}%
  \end{figure}%
}

% 简易三线表：\begin{navtable}{列格式}{表题}{标签}
\newenvironment{navtable}[3]{%
  \begin{table}[htbp]\centering
  \caption{#2}\label{#3}\small
  \begin{tabular}{#1}
  \toprule
}{%
  \bottomrule
  \end{tabular}
  \end{table}%
}

