% 章节编号：一、二、……；图/表全局连续编号
\ctexset{
  chapter    = {name={,、},number=\chinese{chapter},
                format=\centering\LARGE\bfseries,aftername={\hspace{0pt}},
                beforeskip=12pt,afterskip=18pt},
  section    = {format=\Large\bfseries,beforeskip=10pt,afterskip=6pt},
  subsection = {format=\large\bfseries,beforeskip=8pt,afterskip=4pt},
}
\counterwithout{figure}{chapter}
\counterwithout{table}{chapter}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}
\captionsetup{font={small},labelfont=bf,labelsep=quad,hypcap=false}
\captionsetup[figure]{aboveskip=6pt,belowskip=6pt}
\setlength{\floatsep}{10pt}
\setlength{\textfloatsep}{12pt}
\setlength{\intextsep}{10pt}

